@page "/ssr/broken-titled"
@inject ValidationRecorder Evidence

<PageTitle>Static SSR titled mismatch</PageTitle>

<h1>Static SSR: titled mismatched column</h1>

<RuntimeEvidencePanel />

<p>
    This page uses Static SSR because it has no interactive render mode.
    Development can show a developer exception response. Production can remain
    generic, so always capture the server log.
</p>

<QuickGrid Items="@Forecasts" Class="quick-grid">
    <PropertyColumn Property="@(forecast => forecast.Date)" Title="Date" />
    <PropertyColumn Property="@(forecast => forecast.TemperatureC)" Title="Temperature (C)" />

    <EmployeeLastNameColumn />
</QuickGrid>

@code {
    private static readonly IQueryable<WeatherForecast> Forecasts = SampleData.Forecasts;

    protected override void OnInitialized()
    {
        Evidence.LogScenarioStart(
            "SSR-TEMPLATE-TITLED",
            "Static SSR",
            typeof(WeatherForecast),
            typeof(Employee),
            "InvalidOperationException must name 'Employee last name' and the full Employee type.");
    }
}
