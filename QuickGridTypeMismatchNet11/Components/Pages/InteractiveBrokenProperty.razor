@page "/interactive/broken-property"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ValidationRecorder Evidence

<PageTitle>Interactive Server PropertyColumn mismatch</PageTitle>

<h1>Interactive Server: mismatched PropertyColumn</h1>

<RuntimeEvidencePanel />

<p>
    The parent grid contains weather forecasts, but this
    <code>PropertyColumn</code> is explicitly typed for employees.
</p>

<ol>
    <li>Keep the server console visible.</li>
    <li>Click <strong>Run PropertyColumn mismatch</strong> once.</li>
    <li>Capture the scenario-start log and the exception naming <code>First name</code>.</li>
</ol>

<button id="run-interactive-property"
        class="action-button danger"
        @onclick="RunScenario">
    Run PropertyColumn mismatch
</button>

@if (_showMismatch)
{
    <EvidenceErrorBoundary ScenarioId="INTERACTIVE-PROPERTY-TITLED"
                           RunId="@_runId">
        <ChildContent>
            <QuickGrid Items="@Forecasts" Class="quick-grid">
                <PropertyColumn Property="@(forecast => forecast.Date)" Title="Date" />
                <PropertyColumn TGridItem="Employee"
                                TProp="string"
                                Property="@(employee => employee.FirstName)"
                                Title="First name" />
            </QuickGrid>
        </ChildContent>
        <ErrorContent Context="exception">
            <EvidenceErrorDisplay ScenarioId="INTERACTIVE-PROPERTY-TITLED"
                                  RunId="@_runId"
                                  Exception="@exception" />
        </ErrorContent>
    </EvidenceErrorBoundary>
}

@code {
    private bool _showMismatch;
    private string _runId = "(not-started)";

    private static readonly IQueryable<WeatherForecast> Forecasts = SampleData.Forecasts;

    private void RunScenario()
    {
        _runId = Evidence.LogScenarioStart(
            "INTERACTIVE-PROPERTY-TITLED",
            "Interactive Server, prerender disabled",
            typeof(WeatherForecast),
            typeof(Employee),
            "InvalidOperationException must name 'First name' and the full Employee type.");

        _showMismatch = true;
    }
}
